export type AircraftType = { name: string; icao: string; aliases?: string[] }
export type AircraftMatch = {
  status: 'exact' | 'family' | 'fuzzy' | 'none'
  match?: AircraftType
  matches: AircraftType[]
}

// [name, ICAO, aliases]
const RAW: [string, string, string[]?][] = [
  ['Airbus A220-100', 'BCS1'], ['Airbus A220-300', 'BCS3'],
  ['Airbus A318', 'A318'], ['Airbus A319', 'A319'], ['Airbus A319neo', 'A19N'],
  ['Airbus A320', 'A320'], ['Airbus A320neo', 'A20N'],
  ['Airbus A321', 'A321'], ['Airbus A321neo', 'A21N'],
  ['Airbus A330-200', 'A332'], ['Airbus A330-300', 'A333'], ['Airbus A330-900neo', 'A339'],
  ['Airbus A340-300', 'A343'], ['Airbus A340-600', 'A346'],
  ['Airbus A350-900', 'A359'], ['Airbus A350-1000', 'A35K'],
  ['Airbus A380-800', 'A388'],
  ['Boeing 717-200', 'B712'],
  ['Boeing 737-700', 'B737'], ['Boeing 737-800', 'B738'], ['Boeing 737-900', 'B739'],
  ['Boeing 737 MAX 8', 'B38M'], ['Boeing 737 MAX 9', 'B39M'],
  ['Boeing 747-400', 'B744'], ['Boeing 747-8', 'B748'],
  ['Boeing 757-200', 'B752'], ['Boeing 757-300', 'B753'],
  ['Boeing 767-300', 'B763'],
  ['Boeing 777-200', 'B772'], ['Boeing 777-200LR', 'B77L'],
  ['Boeing 777-300', 'B773'], ['Boeing 777-300ER', 'B77W'],
  ['Boeing 787-8', 'B788'], ['Boeing 787-9', 'B789'], ['Boeing 787-10', 'B78X'],
  ['Embraer E170', 'E170'], ['Embraer E175', 'E75L'], ['Embraer E190', 'E190'],
  ['Embraer E195', 'E195'], ['Embraer E195-E2', 'E295'], ['Embraer ERJ-145', 'E145'],
  ['ATR 42-600', 'AT46'], ['ATR 72-600', 'AT76'],
  ['CRJ-700', 'CRJ7'], ['CRJ-900', 'CRJ9'],
  ['De Havilland Dash 8 Q400', 'DH8D', ['Dash 8 Q400', 'Q400', 'Dash 8']],
  ['McDonnell Douglas MD-82', 'MD82', ['MD82', 'MD-80']],
  ['McDonnell Douglas MD-11', 'MD11'],
  ['Tupolev Tu-154', 'T154'], ['Sukhoi Superjet 100', 'SU95'], ['Comac C919', 'C919'],
  ['Cessna 152', 'C152'], ['Cessna 172 Skyhawk', 'C172', ['Cessna 172', '172']],
  ['Cessna 208 Caravan', 'C208', ['Caravan']],
  ['Cirrus SR22', 'SR22'], ['Diamond DA62', 'DA62'], ['Pilatus PC-12', 'PC12'],
  ['Daher TBM 930', 'TBM9', ['TBM 930', 'TBM']], ['Beechcraft King Air 350', 'B350', ['King Air 350']],
]

const AIRCRAFT: AircraftType[] = RAW.map(([name, icao, aliases]) => ({ name, icao, aliases }))

const norm = (s: string) =>
  s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().replace(/[^a-z0-9]/g, '')

const DB = AIRCRAFT.map((type) => ({
  type,
  keys: Array.from(
    new Set([
      norm(type.name),
      norm(type.name.split(' ').slice(1).join(' ')),
      norm(type.icao),
      ...(type.aliases || []).map(norm),
    ].filter(Boolean))
  ),
}))

// Edit distance that counts a swapped pair of letters as one mistake
function dist(a: string, b: string) {
  const d: number[][] = Array.from({ length: a.length + 1 }, () => Array(b.length + 1).fill(0))
  for (let i = 0; i <= a.length; i++) d[i][0] = i
  for (let j = 0; j <= b.length; j++) d[0][j] = j
  for (let i = 1; i <= a.length; i++) {
    for (let j = 1; j <= b.length; j++) {
      const cost = a[i - 1] === b[j - 1] ? 0 : 1
      d[i][j] = Math.min(d[i - 1][j] + 1, d[i][j - 1] + 1, d[i - 1][j - 1] + cost)
      if (i > 1 && j > 1 && a[i - 1] === b[j - 2] && a[i - 2] === b[j - 1]) {
        d[i][j] = Math.min(d[i][j], d[i - 2][j - 2] + 1)
      }
    }
  }
  return d[a.length][b.length]
}

export function matchAircraft(input: string): AircraftMatch {
  const q = norm(input)
  if (!q) return { status: 'none', matches: [] }

  // 1. exact name, ICAO or alias
  const exact = DB.find((e) => e.keys.includes(q))
  if (exact) return { status: 'exact', match: exact.type, matches: [exact.type] }

  // 2. partial like "a380" or "737": one variant = match, several = family
  if (q.length >= 3 && /\d/.test(q)) {
    const part = DB.filter((e) => e.keys.some((k) => k.includes(q))).map((e) => e.type)
    if (part.length === 1) return { status: 'exact', match: part[0], matches: part }
    if (part.length > 1) return { status: 'family', matches: part.slice(0, 8) }
  }

  // 3. typos
  const tol = q.length <= 3 ? 0 : q.length <= 7 ? 1 : q.length <= 11 ? 2 : 3
  let best: { type: AircraftType; d: number } | null = null
  for (const e of DB) {
    for (const k of e.keys) {
      const d = Math.min(dist(q, k), dist(q, k.slice(0, q.length)))
      if (d <= tol && (!best || d < best.d)) best = { type: e.type, d }
    }
  }
  if (best) return { status: 'fuzzy', match: best.type, matches: [best.type] }

  return { status: 'none', matches: [] }
}