# Local Node 24 host with persistent disk; do not use SQLite on Vercel/serverless.
LIVE_HISTORY_DRIVER=sqlite
LIVE_HISTORY_PATH=.local/live-history.sqlite

# Optional continuous sync; use a strong random token, identical on server and worker.
LIVE_SITE_URL=http://localhost:3000
LIVE_SYNC_TOKEN=

# Optional serverless/shared history (requires SQL migration and existing project).
# LIVE_HISTORY_DRIVER=supabase
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional real airport timetables; not needed for existing free radar sources.
AVIATIONSTACK_API_KEY=
